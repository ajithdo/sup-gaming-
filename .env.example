# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
# Both values are safe to ship to the browser (Row Level Security protects the data).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the "publishable" key (sb_publishable_…) or the legacy "anon" key — either works.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# NEVER put the service_role / secret key in a VITE_ variable — it would be public.
